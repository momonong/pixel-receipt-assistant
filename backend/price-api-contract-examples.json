  "status": "Implemented contract; engineering and browser verification remain separate evidence.",
  "endpoints": [
    {
      "method": "GET",
      "path": "/v1/products",
      "query": [
        "query (literal substring, max 500 chars)",
        "limit (1..100, default20)",
        "offset (0..100000, default0)"
      ],
      "auth": "ingest or reviewer"
    },
    {
      "method": "POST",
      "path": "/v1/products",
      "auth": "reviewer; Idempotency-Key required; 201 new/200 replay"
    },
    {
      "method": "GET",
      "path": "/v1/ledger/{id}/price-review",
      "auth": "ingest or reviewer"
    },
    {
      "method": "PUT",
      "path": "/v1/ledger/{id}/price-review",
      "auth": "reviewer; CAS; 200"
    },
    {
      "method": "GET",
      "path": "/v1/ledger/{id}/price-review/history",
      "auth": "ingest or reviewer"
    },
    {
      "method": "GET",
      "path": "/v1/products/{id}/prices",
      "query": [
        "date_from/date_to (optional valid YYYY-MM-DD, inclusive)",
        "limit/offset"
      ],
      "auth": "ingest or reviewer"
    },
    {
      "method": "GET",
      "path": "/v1/overview",
      "query": [
        "date_from/date_to (optional valid YYYY-MM-DD, inclusive)"
      ],
      "auth": "ingest or reviewer"
    },
    {
      "method": "GET",
      "path": "/v1/ledger",
      "query": [
        "q (literal merchant/raw-name substring, max500)",
        "date_from/date_to (inclusive receipt_date)",
        "status (active|voided, omitted=all)",
        "limit/offset"
      ],
      "auth": "ingest or reviewer"
    }
  ],
