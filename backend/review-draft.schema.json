{
  "$defs": {
    "Adjustment": {
      "additionalProperties": false,
      "properties": {
        "raw_label": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Label"
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "add",
                "subtract"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Direction"
        },
        "amount_yuan": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Amount Yuan"
        },
        "amount_effect": {
          "anyOf": [
            {
              "enum": [
                "separate_from_line_totals",
                "included_in_line_totals"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount Effect"
        },
        "scope": {
          "anyOf": [
            {
              "enum": [
                "receipt",
                "items"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scope"
        },
        "item_positions": {
          "default": [],
          "items": {
            "maximum": 99,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 100,
          "title": "Item Positions",
          "type": "array"
        }
      },
      "required": [
        "raw_label",
        "direction",
        "amount_yuan",
        "scope"
      ],
      "title": "Adjustment",
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "pixelreceipt-central-candidate-1",
          "title": "Schema",
          "type": "string"
        },
        "currency": {
          "const": "TWD",
          "title": "Currency",
          "type": "string"
        },
        "amount_unit": {
          "const": "TWD_YUAN",
          "title": "Amount Unit",
          "type": "string"
        },
        "merchant": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Merchant"
        },
        "receipt_date": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Receipt Date"
        },
        "printed_total_yuan": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Printed Total Yuan"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/Item"
          },
          "maxItems": 100,
          "title": "Items",
          "type": "array"
        },
        "adjustments": {
          "items": {
            "$ref": "#/$defs/Adjustment"
          },
          "maxItems": 50,
          "title": "Adjustments",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "currency",
        "amount_unit",
        "merchant",
        "receipt_date",
        "printed_total_yuan",
        "items",
        "adjustments"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "ContentQuantity": {
      "additionalProperties": false,
      "properties": {
        "value_decimal": {
          "pattern": "^(0|[1-9][0-9]{0,8})(\\.[0-9]{1,6})?$",
          "title": "Value Decimal",
          "type": "string"
        },
        "unit": {
          "enum": [
            "g",
            "kg",
            "ml",
            "l",
            "piece"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "value_decimal",
        "unit"
      ],
      "title": "ContentQuantity",
      "type": "object"
    },
    "Item": {
      "additionalProperties": false,
      "properties": {
        "raw_name": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Name"
        },
        "quantity": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quantity"
        },
        "printed_unit_price_yuan": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Printed Unit Price Yuan"
        },
        "printed_line_total_yuan": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Printed Line Total Yuan"
        },
        "brand": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Brand"
        },
        "specification": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Specification"
        },
        "content_quantity": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentQuantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "raw_name",
        "quantity",
        "printed_line_total_yuan"
      ],
      "title": "Item",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "expected_revision": {
      "exclusiveMaximum": 9223372036854775807,
      "minimum": 1,
      "title": "Expected Revision",
      "type": "integer"
    },
    "candidate": {
      "$ref": "#/$defs/Candidate"
    },
    "review_note": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Note"
    }
  },
  "required": [
    "expected_revision",
    "candidate"
  ],
  "title": "ReviewDraft",
  "type": "object"
}
